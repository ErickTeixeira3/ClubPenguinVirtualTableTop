{
  "name": "clubpenguinvtt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:emu",
    "dev:emu": "vite --mode emulator",
    "dev:prod": "node scripts/dev/dev-prod.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "lint:layers": "node scripts/check-layers.mjs",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-cpvtt",
    "seed:emu": "node scripts/ops/seed-emulator.mjs",
    "export:prod": "node scripts/ops/export-production.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-cpvtt-test --only auth,firestore,database \"vitest run --config vitest.rules.config.js\"",
    "check": "npm run lint && npm run lint:layers && npm run test && npm run test:rules && npm run build",
    "migrate": "node scripts/migrations/run.mjs",
    "audit:schema": "node scripts/migrations/audit-v2.mjs",
    "login": "firebase login",
    "logout": "firebase logout",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.1.0",
    "firebase-admin": "14.5.1",
    "firebase-tools": "15.36.0",
    "jsdom": "29.1.1",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  }
}
