# Configuração do app contra os Emuladores do Firebase (npm run dev:emu).
# Sem segredos: projeto "demo-" (o Firebase recusa qualquer acesso a recursos reais) e chaves fictícias.
# As portas precisam coincidir com o bloco "emulators" do firebase.json (verificado por teste).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-cpvtt.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://demo-cpvtt-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=demo-cpvtt
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

VITE_EMULATOR_HOST=127.0.0.1
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8085
VITE_EMULATOR_DATABASE_PORT=9000
